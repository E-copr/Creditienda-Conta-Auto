# Copia este archivo como .env para pruebas locales.
# EN PRODUCCION (Railway) estas variables se configuran como "Variables" del
# proyecto, nunca se suben al repositorio.

# ---- factura.com (API v4) ----
# Verifica estos valores contra tu panel de factura.com > Configuracion > API
FACTURACOM_API_BASE_URL=https://api.factura.com/v4
FACTURACOM_API_KEY=
FACTURACOM_SECRET_KEY=
FACTURACOM_PLUGIN_KEY=

# ---- SIMCO (portal de proveedores CrediTienda) ----
SIMCO_LOGIN_URL=https://creditienda-proveedores.concredito.com.mx/login
SIMCO_USERNAME=
SIMCO_PASSWORD=
# Llave secreta TOTP obtenida al vincular Google Authenticator para la cuenta
# de servicio (NO es el codigo de 6 digitos, es la llave base32 fija).
SIMCO_TOTP_SECRET=

# ---- Bitacora (Google Sheet nuevo, propio de este proyecto) ----
# Default: "Creditienda - Bitacora Cargas SIMCO Claude"
GOOGLE_SHEET_ID=1RT06W3OF25sj8KAUwoQAvVy9c2M24iEZ1vBltGEFRR4
# Ruta al JSON de la cuenta de servicio de Google (Sheets API habilitada)
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./google-service-account.json
SHEET_TAB_BITACORA=Bitacora Carga SIMCO - Claude

# ---- Sheet fuente: el que YA llena el Make.com existente (UUID <-> orden) ----
# Por default apunta al sheet que ya usan (solo lectura). Cambialo si migran de sheet.
SOURCE_SHEET_ID=1E-UEacAMnJOItUERFv9rvQdI6Laa30ZUzA-tQ23krms
# Nombre literal de la pestana (tal como aparece en Google Sheets), NO el gid de la URL.
SOURCE_SHEET_TAB=
SOURCE_UUID_HEADER=UUID
# Invoice UID corto de factura.com (NO el UUID largo) - se usa para descargar PDF/XML.
SOURCE_INVOICE_UID_HEADER=Invoice UID
# Confirmado: SIMCO espera el valor de "Shopify Order ID" como Numero de orden.
SOURCE_ORDER_NUMBER_HEADER=Shopify Order ID
SOURCE_STATUS_HEADER=Estado
SOURCE_FECHA_HEADER=Fecha

# ---- Notificaciones ----
SLACK_WEBHOOK_URL=

# Notificacion en pantalla nativa de macOS (Centro de notificaciones) al
# terminar cada corrida. "false" para desactivarla.
MAC_NOTIFICATIONS=true

# Correo de resumen por SMTP de Gmail. Vacio EMAIL_SMTP_USER = desactivado.
# EMAIL_SMTP_APP_PASSWORD es una "contrasena de aplicacion" generada en
# https://myaccount.google.com/apppasswords (requiere verificacion en dos
# pasos activada en esa cuenta) - NO la contrasena normal de Gmail.
EMAIL_SMTP_USER=
EMAIL_SMTP_APP_PASSWORD=
EMAIL_TO=ecorps.usa@gmail.com

# ---- Job ----
# Dias hacia atras a revisar si no hay corrida previa registrada en la bitacora
DEFAULT_LOOKBACK_DAYS=3
DOWNLOAD_DIR=./tmp/facturas
HEADLESS=true
